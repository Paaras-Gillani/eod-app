# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-random-string

# Gemini API key (free tier), used for reading the deposit/redeem screenshot.
# Get one at https://aistudio.google.com/apikey - no credit card required.
GEMINI_API_KEY=AQ.Ab8RN6JGc0Nhzkjh-cozUJufghujBPwYT1on_0hu7vD8-t__ww

# Vision model to use. gemini-3.5-flash is free-tier (as of July 2026) and
# good enough for reading a table out of a screenshot. If you get a "model
# no longer available" error, check https://ai.google.dev/gemini-api/docs/pricing
# for the current free-tier model name and update this.
GEMINI_MODEL=gemini-3.5-flash
